# Copy to .env and edit if the defaults do not suit.
# Provider selection: which model the agent (and chat) calls.
MODEL_PROVIDER=ollama                       # ollama | gemini | groq

# Ollama: no key needed, works with a local `ollama serve` and the model pulled.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Gemini: reached through its OpenAI-compatible endpoint, same call shape as Ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq: cloud-hosted, so it runs no local compute, with a generous free tier
# (openai/gpt-oss-120b: 30 RPM / 1,000 RPD / 8K TPM). Get a key at console.groq.com.
# Check console.groq.com/docs/deprecations before assuming a model id still
# works - Groq retires models on a real schedule (llama-3.3-70b-versatile,
# this project's first choice, was removed 2026-06-17).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# The fhir-mcp server the agent talks to.
FHIR_MCP_URL=http://127.0.0.1:3001/mcp

# Step budget per patient investigation. 18, not 12: a correct pass needs
# about 9 tool calls, and one fumbled parameter shouldn't exhaust the budget.
AGENT_MAX_STEPS=18

# The date every gap check's time window is measured from. Must match
# whatever the oracle is run with (see eval_runner.py's DEFAULT_AS_OF), or
# the agent is silently answering a different question than it's graded
# against - the two date-sensitive checks drift the answer key by
# +1/+4/+10 findings at +30/+90/+180 days past this value.
AGENT_AS_OF=2026-09-10
