# Copy to .env and edit if the defaults do not suit.
# Defaults already work against the repo-root docker-compose.yml, so this file
# is only needed to change something.

# The FHIR server to talk to.
FHIR_MCP_BASE_URL=http://localhost:8080/fhir

# How resources are shaped before the model sees them: nested, flattened, or
# compact. This is the Experiment 3 dial.
FHIR_MCP_SERIALISATION=nested

# Per-request timeout against the FHIR server, in seconds.
FHIR_MCP_TIMEOUT_SECONDS=30

# Where this MCP server listens.
FHIR_MCP_HOST=127.0.0.1
FHIR_MCP_PORT=3001
